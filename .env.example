# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase Dashboard > Project Settings > API). NEVER commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Secret! Server-only, used to create/manage users. Get it from
# Supabase Dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# QUAL AMBIENTE É ESTE. Só o ambiente de TREINO define isto, com o valor
# "treino": ele passa a mostrar uma faixa de aviso no topo de todas as telas e
# muda o nome da aba, para ninguém confundir com o sistema de verdade.
# Em produção NÃO defina — sem a variável, o sistema se comporta como o real.
# NEXT_PUBLIC_AMBIENTE=treino

# ASSINATURA DIGITAL (ZapSign) — plano docs/assinaturas/PLANO-ZS0.md §12.
# Só servidor. No desenvolvimento e no treino use a conta SANDBOX
# (sandbox.app.zapsign.com.br); o token de produção só existe na Vercel de
# produção. Sem o token, as telas dizem que a assinatura digital não está
# configurada e nada é enviado.
# ZAPSIGN_API_TOKEN=
# `sandbox` (padrão quando vazio) ou `production`.
# ZAPSIGN_ENV=sandbox
# O mesmo valor cadastrado como cabeçalho `x-riszon-webhook-secret` no webhook
# da conta ZapSign (ZS3). Qualquer texto longo e aleatório.
# ZAPSIGN_WEBHOOK_SECRET=
# As rotinas de /api/cron/* só rodam com este segredo; a Vercel manda sozinha.
# CRON_SECRET=
