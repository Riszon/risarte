# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase Dashboard > Project Settings > API). NEVER commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Secret! Server-only, used to create/manage users. Get it from
# Supabase Dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# QUAL AMBIENTE É ESTE. Só o ambiente de TREINO define isto, com o valor
# "treino": ele passa a mostrar uma faixa de aviso no topo de todas as telas e
# muda o nome da aba, para ninguém confundir com o sistema de verdade.
# Em produção NÃO defina — sem a variável, o sistema se comporta como o real.
# NEXT_PUBLIC_AMBIENTE=treino
