{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-test/types/**/*.ts",
    ".next-test/dev/types/**/*.ts",
    ".next-verify-planilha/types/**/*.ts",
    ".next-verify-planilha/dev/types/**/*.ts",
    ".next-verify-vagas/types/**/*.ts",
    ".next-verify-vagas/dev/types/**/*.ts",
    ".next-verify-impl/types/**/*.ts",
    ".next-verify-impl/dev/types/**/*.ts",
    ".next-verify-emp/types/**/*.ts",
    ".next-verify-emp/dev/types/**/*.ts",
    ".next-verify-perm/types/**/*.ts",
    ".next-verify-perm/dev/types/**/*.ts",
    ".next-verify-1049/types/**/*.ts",
    ".next-verify-1049/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions",
    ".next-test"
  ]
}
